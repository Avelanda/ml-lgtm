@@ -0,0 +1,607 @@
+import math
+from typing import Literal
+
+import pytest
+import torch
+
+from gsplat._helper import load_test_data
+import os
+import imageio
+from gsplat.cuda._wrapper import TextureAlphaMode
+
+device = torch.device("cuda:0")
+
+
+def check_allclose(
+    actual,
+    expected,
+    rtol=1e-4,
+    atol=1e-4,
+    pass_threshold=1.0,
+    name="tensors",
+):
+    """
+    Check if tensors are close and print detailed statistics.
+
+    Args:
+        actual: First tensor to compare
+        expected: Second tensor to compare
+        rtol: Relative tolerance
+        atol: Absolute tolerance
+        pass_threshold: Minimum fraction of values that must be within tolerance
+        name: Name for the comparison (for printing)
+    """
+    # Flatten tensors for easier computation
+    actual_flat = actual.flatten()
+    expected_flat = expected.flatten()
+
+    # Compute absolute and relative differences
+    abs_diff = torch.abs(actual_flat - expected_flat)
+    rel_diff = abs_diff / (torch.abs(expected_flat) + atol)
+
+    # Check which elements are within tolerance
+    within_threshold = (abs_diff <= atol) | (rel_diff <= rtol)
+
+    total_elements = len(actual_flat)
+    within_count = within_threshold.sum().item()
+    within_percentage = (within_count / total_elements) * 100
+
+    max_abs_diff = abs_diff.max().item()
+    max_rel_diff = rel_diff.max().item()
+    mean_abs_diff = abs_diff.float().mean().item()
+    mean_rel_diff = rel_diff.float().mean().item()
+
+    # Color coding: green if >98% match, red otherwise
+    if within_percentage > 98.0:
+        color_start = "\033[92m"  # Green
+        color_end = "\033[0m"  # Reset
+    else:
+        color_start = "\033[91m"  # Red
+        color_end = "\033[0m"  # Reset
+
+    print(
+        f"{color_start}{name}: {within_count} ({within_percentage:.1f}%) of {total_elements} within threshold{color_end}"
+    )
+    print(f"  Max abs diff: {max_abs_diff:.2e}, Mean abs diff: {mean_abs_diff:.2e}")
+    if within_percentage < 95.0:  # Warn if less than 95% are within threshold
+        print(f"  WARNING: Only {within_percentage:.1f}% of values within threshold!")
+
+    # Check if percentage meets the required fraction
+    required_percentage = pass_threshold * 100.0
+    if within_percentage < required_percentage:
+        raise AssertionError(
+            f"{name}: Only {within_percentage:.1f}% of values are within tolerance, "
+            f"but {required_percentage:.1f}% required. "
+            f"Max abs diff: {max_abs_diff:.2e}, Mean abs diff: {mean_abs_diff:.2e}"
+        )
+
+    return within_count == total_elements
+
+
+def generate_test_data_simple():
+    """Generate simple test data (original fixture data)."""
+    torch.manual_seed(42)
+
+    # Make the gaussians overlap and have different depths
+    N = 2
+    xs = torch.linspace(-0.1, 0.1, N, device=device)
+    ys = torch.linspace(-0.1, 0.1, N, device=device)
+    xys = torch.stack(torch.meshgrid(xs, ys, indexing="ij"), dim=-1).reshape(-1, 2)
+    zs = torch.linspace(2.0, 4.0, xys.shape[0], device=device).reshape(-1, 1)
+    means = torch.cat([xys, zs], dim=-1)
+    quats = torch.tensor([[1.0, 0.0, 0.0, 0]], device=device).repeat(len(means), 1)
+    scales = torch.ones_like(means)
+    scales[..., :2] *= 0.1
+    opacities = torch.ones(1, len(means), device=device) * 0.5
+    colors = torch.rand(1, len(means), 3, device=device)
+    viewmats = torch.eye(4, device=device).reshape(1, 4, 4)
+    # W, H = 24, 20
+    W, H = 80, 60
+    fx, fy, cx, cy = W, W, W // 2, H // 2
+    Ks = torch.tensor(
+        [[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]], device=device
+    ).reshape(1, 3, 3)
+    return {
+        "means": means,
+        "quats": quats,
+        "scales": scales,
+        "opacities": opacities,
+        "colors": colors,
+        "viewmats": viewmats,
+        "Ks": Ks,
+        "width": W,
+        "height": H,
+    }
+
