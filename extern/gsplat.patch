+def bilinear_texture_sampler_unbounded(
+    us: Tensor,  # [M] UV coordinates in x-direction (range [-texture_sigma, texture_sigma])
+    vs: Tensor,  # [M] UV coordinates in y-direction (range [-texture_sigma, texture_sigma])
+    textures: Tensor,  # [M, channels, texture_size, texture_size] batched textures
+    texture_size: int,
+    channels: int,
+    texture_sigma: float = 1.0,
+) -> Tensor:
+    """
+    Vectorized PyTorch implementation of bilinear texture sampling with configurable sigma parameter.
+
+    When texture_sigma == 1.0, it's equivalent to PyTorch's grid_sample with:
+    - mode="bilinear"
+    - padding_mode="border"
+    - align_corners=False
+
+    This version implements the unbounded sampling approach that applies explicit border clamping
+    instead of in-bounds checking, and doesn't support texture_color_normalize or texture_color_crop
+    options (as these are not part of the unbounded sampling specification).
+
+    Args:
+        us: Normalized coordinates in x-direction (range [-texture_sigma, texture_sigma]). Shape [M].
+        vs: Normalized coordinates in y-direction (range [-texture_sigma, texture_sigma]). Shape [M].
+        textures: Batched texture data with shape [M, channels, texture_size, texture_size].
+        texture_size: The size (width and height) of the square textures.
+        channels: Number of channels in each texture.
+        texture_sigma: Controls the coordinate range and BBSplat span. Default 1.0.
+
+    Returns:
+        Sampled values with shape [M, channels].
+    """
+    M = us.shape[0]
+    device = textures.device
+    dtype = textures.dtype
+
+    # Convert from norm_im_coords [-sigma, sigma] to pix_coords
+    # Matches CUDA: (u + texture_sigma) / (2.0f * texture_sigma) * texture_size - 0.5f
+    x = (us + texture_sigma) / (2.0 * texture_sigma) * texture_size - 0.5
+    y = (vs + texture_sigma) / (2.0 * texture_sigma) * texture_size - 0.5
+
+    # Apply border clamping (equivalent to padding_mode="border")
+    # Matches CUDA: fmaxf(0.0f, fminf(texture_size - 1.0f, x))
+    x = torch.clamp(x, min=0.0, max=texture_size - 1.0)
+    y = torch.clamp(y, min=0.0, max=texture_size - 1.0)
+
+    # Get integer coordinates for the 4 surrounding pixels
+    ix_nw = torch.floor(x).long()
+    iy_nw = torch.floor(y).long()
+    ix_ne = torch.clamp(ix_nw + 1, max=texture_size - 1)
+    iy_ne = iy_nw
+    ix_sw = ix_nw
+    iy_sw = torch.clamp(iy_nw + 1, max=texture_size - 1)
+    ix_se = ix_ne
+    iy_se = iy_sw
+
+    # Get fractional parts for interpolation
+    f_x = x - ix_nw.float()
+    f_y = y - iy_nw.float()
+
+    # Calculate bilinear weights (matches CUDA implementation)
+    nw = (1.0 - f_x) * (1.0 - f_y)
+    ne = f_x * (1.0 - f_y)
+    sw = (1.0 - f_x) * f_y
+    se = f_x * f_y
+
+    # Initialize result
+    result = torch.zeros(M, channels, device=device, dtype=dtype)
+
+    # Create batch indices for advanced indexing
+    batch_indices = torch.arange(M, device=device)
+
+    # Vectorized sampling with bilinear interpolation
+    # All coordinates are guaranteed to be in bounds due to clamping
+    nw_values = textures[batch_indices, :, iy_nw, ix_nw]  # [M, channels]
+    result += nw_values * nw.unsqueeze(1)
+
+    ne_values = textures[batch_indices, :, iy_ne, ix_ne]  # [M, channels]
+    result += ne_values * ne.unsqueeze(1)
+
+    sw_values = textures[batch_indices, :, iy_sw, ix_sw]  # [M, channels]
+    result += sw_values * sw.unsqueeze(1)
+
+    se_values = textures[batch_indices, :, iy_se, ix_se]  # [M, channels]
+    result += se_values * se.unsqueeze(1)
+
+    return result
 
 
