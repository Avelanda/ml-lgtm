+def _test_rasterize_textures_base(
+    texture_color_sigma=1.0,
+    texture_alpha_mode=None,
+    suffix="unspecified",
+    force_texture_alphas_none=False,
+    data_source: Literal["simple", "random"] = "simple",
+):
+    """Base test function for BBSplat texture functionality in 2DGS rasterization comparing CUDA and PyTorch implementations."""
+    from gsplat.cuda._torch_impl_2dgs import _rasterize_to_pixels_2dgs
+    from gsplat.cuda._wrapper import (
+        TextureAlphaMode,
+        fully_fused_projection_2dgs,
+        isect_offset_encode,
+        isect_tiles,
+        rasterize_to_pixels_2dgs,
+    )
+
+    # Set default texture_alpha_mode if not provided
+    if texture_alpha_mode is None:
+        texture_alpha_mode = TextureAlphaMode.TEXTURE
+
+    torch.manual_seed(42)
+
+    # Generate test data based on data_source
+    if data_source == "random":
+        current_test_data = generate_test_data_random()
+    else:  # simple
+        current_test_data = generate_test_data_simple()
+
+    Ks = current_test_data["Ks"]
+    viewmats = current_test_data["viewmats"]
+    height = current_test_data["height"]
+    width = current_test_data["width"]
+    quats = current_test_data["quats"]
+    scales = current_test_data["scales"]
+    means = current_test_data["means"]
+    colors = current_test_data["colors"]
+    opacities = current_test_data["opacities"]
+
+    N = means.shape[0]
+    C = viewmats.shape[0]
+
+    # Create texture data
+    texture_size = 4  # 4x4 texture
+    texture_colors = torch.rand(N, 3, texture_size, texture_size, device=device)
+    texture_alphas = torch.rand(N, texture_size, texture_size, device=device)
+
+    # Enable gradients for texture parameters
+    texture_colors.requires_grad = True
+    texture_alphas.requires_grad = True
+
+    # Handle texture_alphas based on mode and test parameters
+    if force_texture_alphas_none:
+        texture_alphas = None
+
+    radii, means2d, depths, ray_transforms, normals = fully_fused_projection_2dgs(
+        means, quats, scales, viewmats, Ks, width, height
+    )
+
+    colors = torch.concatenate((colors, depths.unsqueeze(-1)), dim=-1)
+    backgrounds = torch.zeros((C, colors.shape[-1]), device=device)
+
+    # Identify intersecting tiles
+    tile_size = 16
+    tile_width = math.ceil(width / float(tile_size))
+    tile_height = math.ceil(height / float(tile_size))
+    tiles_per_gauss, isect_ids, flatten_ids = isect_tiles(
+        means2d, radii, depths, tile_size, tile_width, tile_height
+    )
+    isect_offsets = isect_offset_encode(isect_ids, C, tile_width, tile_height)
+
+    colors = colors.repeat(C, 1, 1)
+    opacities = opacities.repeat(C, 1)
+    normals = normals.repeat(C, 1, 1)
+    densify = torch.zeros_like(means2d, device=means2d.device)
+
+    means2d.requires_grad = True
+    ray_transforms.requires_grad = True
+    colors.requires_grad = True
+    opacities.requires_grad = True
+    backgrounds.requires_grad = True
+    normals.requires_grad = True
+    densify.requires_grad = True
+
+    # Test CUDA implementation with textures and new features
+    (
+        render_colors,
+        render_alphas,
+        render_normals,
+        _,
+        render_median,
+    ) = rasterize_to_pixels_2dgs(
+        means2d,
+        ray_transforms,
+        colors,
+        opacities,
+        normals,
+        densify,
+        width,
+        height,
+        tile_size,
+        isect_offsets,
+        flatten_ids,
+        backgrounds=backgrounds,
+        distloss=True,
+        texture_colors=texture_colors,
+        texture_alphas=texture_alphas,
+        texture_size=texture_size,
+        texture_color_sigma=texture_color_sigma,
+        texture_alpha_mode=texture_alpha_mode,
+    )
+
+    # Test PyTorch implementation with textures and new features
+    _render_colors, _render_alphas, _render_normals = _rasterize_to_pixels_2dgs(
+        means2d,
+        ray_transforms,
+        colors,
+        normals,
+        opacities,
+        width,
+        height,
+        tile_size,
+        isect_offsets,
+        flatten_ids,
+        backgrounds=backgrounds,
+        texture_colors=texture_colors,
+        texture_alphas=texture_alphas,
+        texture_size=texture_size,
+        texture_color_sigma=texture_color_sigma,
+        texture_alpha_mode=texture_alpha_mode,
+    )
+
+    # Compare forward pass results
+    cuda_render = render_colors[0].detach().cpu()
+    torch_render = _render_colors[0].detach().cpu()
+    diff = (cuda_render - torch_render).abs()
+    os.makedirs("renders", exist_ok=True)
+    full_suffix = f"{suffix}_{data_source}"
+    imageio.imwrite(
+        f"renders/cuda_render_bbsplat_{full_suffix}.png", (255 * cuda_render).byte()
+    )
+    imageio.imwrite(
+        f"renders/torch_render_bbsplat_{full_suffix}.png", (255 * torch_render).byte()
+    )
+    imageio.imwrite(f"renders/diff_bbsplat_{full_suffix}.png", (255 * diff).byte())
+
+    # Test backward pass with textures
+    v_render_colors = torch.rand_like(render_colors)
+    v_render_alphas = torch.rand_like(render_alphas)
+    v_render_normals = torch.rand_like(render_normals)
+
+    # CUDA backward pass
+    cuda_inputs = [
+        means2d,
+        ray_transforms,
+        colors,
+        opacities,
+        backgrounds,
+        normals,
+        texture_colors,
+    ]
+    if texture_alphas is not None:
+        cuda_inputs.append(texture_alphas)
+
+    cuda_grads = torch.autograd.grad(
+        (render_colors * v_render_colors).sum()
+        + (render_alphas * v_render_alphas).sum()
+        + (render_normals * v_render_normals).sum(),
+        cuda_inputs,
+        allow_unused=True,
+    )
+
+    # Unpack gradients
+    if texture_alphas is not None:
+        (
+            v_means2d,
+            v_ray_transforms,
+            v_colors,
+            v_opacities,
+            v_backgrounds,
+            v_normals,
+            v_texture_colors,
+            v_texture_alphas,
+        ) = cuda_grads
+    else:
+        (
+            v_means2d,
+            v_ray_transforms,
+            v_colors,
+            v_opacities,
+            v_backgrounds,
+            v_normals,
+            v_texture_colors,
+        ) = cuda_grads
+        v_texture_alphas = None
+
+    # PyTorch backward pass
+    torch_inputs = [
+        ray_transforms,
+        colors,
+        backgrounds,
+        normals,
+        texture_colors,
+    ]
+    if texture_alphas is not None:
+        torch_inputs.append(texture_alphas)
+
+    torch_grads = torch.autograd.grad(
+        (_render_colors * v_render_colors).sum()
+        + (_render_alphas * v_render_alphas).sum()
+        + (_render_normals * v_render_normals).sum(),
+        torch_inputs,
+        allow_unused=True,
+    )
+
+    # Unpack gradients
+    if texture_alphas is not None:
+        (
+            _v_ray_transforms,
+            _v_colors,
+            _v_backgrounds,
+            _v_normals,
+            _v_texture_colors,
+            _v_texture_alphas,
+        ) = torch_grads
+    else:
+        (
+            _v_ray_transforms,
+            _v_colors,
+            _v_backgrounds,
+            _v_normals,
+            _v_texture_colors,
+        ) = torch_grads
+        _v_texture_alphas = None
+
+    # Check forward pass closeness - expect failures with new features
+    print(f"\n=== Forward Pass Comparison ({full_suffix}) ===")
+    check_allclose(render_colors, _render_colors, name="render_colors")
+    check_allclose(render_alphas, _render_alphas, name="render_alphas")
+    check_allclose(render_normals, _render_normals, name="render_normals")
+
+    # Check backward pass closeness - expect failures with new features
+    print(f"=== Backward Pass Comparison ({full_suffix}) ===")
+    check_allclose(v_ray_transforms, _v_ray_transforms, name="v_ray_transforms")
+    check_allclose(v_colors, _v_colors, name="v_colors")
+    check_allclose(v_backgrounds, _v_backgrounds, name="v_backgrounds")
+    check_allclose(v_normals, _v_normals, name="v_normals")
+    check_allclose(v_texture_colors, _v_texture_colors, name="v_texture_colors")
+
+    # Handle texture_alphas gradients - simple and clear logic
+    if texture_alphas is None:
+        # Case 1: texture_alphas was None -> None gradients
+        assert v_texture_alphas is None
+        assert _v_texture_alphas is None
+    elif texture_alpha_mode == TextureAlphaMode.GAUSSIAN:
+        # Case 2: GAUSSIAN mode, but texture_alphas is specifid -> zero gradients
+        zero_grads = torch.zeros_like(v_texture_alphas)
+        check_allclose(v_texture_alphas, zero_grads, name="v_texture_alphas")
+        check_allclose(_v_texture_alphas, zero_grads, name="_v_texture_alphas")
+    else:
+        # Case 3: Normal modes (TEXTURE, MULTIPLY) -> actual gradients
+        check_allclose(v_texture_alphas, _v_texture_alphas, name="v_texture_alphas")
+
+
