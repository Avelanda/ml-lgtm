+def test_projection_2dgs_bbsplat():
+    from gsplat.cuda._torch_impl_2dgs import _fully_fused_projection_2dgs
+    from gsplat.cuda._wrapper import fully_fused_projection_2dgs
+
+    torch.manual_seed(42)
+
+    test_data = generate_test_data_simple()
+    Ks = test_data["Ks"]
+    viewmats = test_data["viewmats"]
+    height = test_data["height"]
+    width = test_data["width"]
+    quats = test_data["quats"]
+    scales = test_data["scales"]
+    means = test_data["means"]
+    viewmats.requires_grad = True
+    quats.requires_grad = True
+    scales.requires_grad = True
+    means.requires_grad = True
+
+    # Create texture data
+    texture_size = 4  # 4x4 texture
+    N = means.shape[0]
+    texture_colors = torch.rand(N, 3, texture_size, texture_size, device=device)
+    texture_alphas = torch.rand(N, texture_size, texture_size, device=device)
+
+    # Enable gradients for texture parameters
+    texture_colors.requires_grad = True
+    texture_alphas.requires_grad = True
+
+    # forward
+    _radii, _means2d, _depths, _ray_transforms, _normals = _fully_fused_projection_2dgs(
+        means=means,
+        quats=quats,
+        scales=scales,
+        viewmats=viewmats,
+        Ks=Ks,
+        width=width,
+        height=height,
+        texture_scale_multiplier=2.0,
+    )
+    _ray_transforms = _ray_transforms.permute(
+        (0, 1, 3, 2)
+    )  # TODO(WZ): Figure out why do we need to permute here
+
+    radii, means2d, depths, ray_transforms, normals = fully_fused_projection_2dgs(
+        means=means,
+        quats=quats,
+        scales=scales,
+        viewmats=viewmats,
+        Ks=Ks,
+        width=width,
+        height=height,
+        texture_scale_multiplier=2.0,
+    )
+
+    # TODO (WZ): is the following true for 2dgs as while?
+    # radii is integer so we allow for 1 unit difference
+    valid = ((radii > 0) & (_radii > 0)).all(dim=-1)
+    check_allclose(radii, _radii, rtol=0, atol=1, name="radii")
+    check_allclose(means2d[valid], _means2d[valid], name="means2d")
+    check_allclose(depths[valid], _depths[valid], name="depths")
+    check_allclose(ray_transforms[valid], _ray_transforms[valid], name="ray_transforms")
+    check_allclose(normals[valid], _normals[valid], name="normals")
+
+    # backward
+    v_means2d = torch.randn_like(means2d) * valid[..., None]
+    v_depths = torch.randn_like(depths) * valid
+    v_ray_transforms = torch.randn_like(ray_transforms) * valid[..., None, None]
+    v_normals = torch.randn_like(normals) * valid[..., None]
+
+    v_viewmats, v_quats, v_scales, v_means = torch.autograd.grad(
+        (means2d * v_means2d).sum()
+        + (depths * v_depths).sum()
+        + (ray_transforms * v_ray_transforms).sum()
+        + (normals * v_normals).sum(),
+        (viewmats, quats, scales, means),
+    )
+    _v_viewmats, _v_quats, _v_scales, _v_means = torch.autograd.grad(
+        (_means2d * v_means2d).sum()
+        + (_depths * v_depths).sum()
+        + (_ray_transforms * v_ray_transforms).sum()
+        + (_normals * v_normals).sum(),
+        (viewmats, quats, scales, means),
+    )
+
+    check_allclose(v_viewmats, _v_viewmats, name="v_viewmats")
+    check_allclose(v_quats, _v_quats, name="v_quats")
+    check_allclose(v_scales[..., :2], _v_scales[..., :2], name="v_scales")
+    check_allclose(v_means, _v_means, name="v_means")
+
