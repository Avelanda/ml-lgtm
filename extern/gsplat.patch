+def bilinear_texture_sampler(
+    us: Tensor,  # [M] UV coordinates in x-direction (range [-1, 1])
+    vs: Tensor,  # [M] UV coordinates in y-direction (range [-1, 1])
+    textures: Tensor,  # [M, channels, texture_size, texture_size] batched textures
+    texture_size: int,
+    channels: int,
+    texture_normalize: bool = False,
+    texture_crop: bool = False,
+) -> Tensor:
+    """
+    Vectorized PyTorch implementation of bilinear texture sampling.
+    Adapted from grid_sample.py with configurable texture_normalize and texture_crop.
+
+    This version is fully vectorized for efficient batched operations.
+
+    Args:
+        us: Normalized coordinates in x-direction (range [-1, 1]). Shape [M].
+        vs: Normalized coordinates in y-direction (range [-1, 1]). Shape [M].
+        textures: Batched texture data with shape [M, channels, texture_size, texture_size].
+        texture_size: The size (width and height) of the square textures.
+        channels: Number of channels in each texture.
+        texture_normalize: If True, normalizes weights for in-bounds samples.
+        texture_crop: If True, returns zeros for any sample where any corner is out of bounds.
+
+    Returns:
+        Sampled values with shape [M, channels].
+    """
+    M = us.shape[0]
+    device = textures.device
+    dtype = textures.dtype
+
+    # Convert UV coordinates to texture coordinates
+    x = ((us + 1) / 2) * (texture_size - 1)
+    y = ((vs + 1) / 2) * (texture_size - 1)
+
+    # Get integer indices for the four corners
+    ix_nw = torch.floor(x).long()
+    iy_nw = torch.floor(y).long()
+
+    ix_ne = ix_nw + 1
+    iy_ne = iy_nw
+    ix_sw = ix_nw
+    iy_sw = iy_nw + 1
+    ix_se = ix_nw + 1
+    iy_se = iy_nw + 1
+
+    # Calculate weights for the four neighboring pixels
+    nw = (ix_se.float() - x) * (iy_se.float() - y)
+    ne = (x - ix_sw.float()) * (iy_sw.float() - y)
+    sw = (ix_ne.float() - x) * (y - iy_ne.float())
+    se = (x - ix_nw.float()) * (y - iy_nw.float())
+
+    # Check bounds for all four corners
+    def in_bounds_2d(h: Tensor, w: Tensor, H: int, W: int) -> Tensor:
+        return (h >= 0) & (h < H) & (w >= 0) & (w < W)
+
+    in_bounds_nw = in_bounds_2d(iy_nw, ix_nw, texture_size, texture_size)
+    in_bounds_ne = in_bounds_2d(iy_ne, ix_ne, texture_size, texture_size)
+    in_bounds_sw = in_bounds_2d(iy_sw, ix_sw, texture_size, texture_size)
+    in_bounds_se = in_bounds_2d(iy_se, ix_se, texture_size, texture_size)
+    all_in_bounds = in_bounds_nw & in_bounds_ne & in_bounds_sw & in_bounds_se
+
+    # Initialize result
+    result = torch.zeros(M, channels, device=device, dtype=dtype)
+
+    # Handle texture_color_crop case - return zeros for samples where any corner is out of bounds
+    if texture_crop:
+        # Only process samples where all corners are in bounds
+        valid_samples = all_in_bounds
+        if not valid_samples.any():
+            return result
+    else:
+        # Process all samples
+        valid_samples = torch.ones(M, dtype=torch.bool, device=device)
+
+    # Normalize weights if requested and only for valid samples
+    if texture_normalize:
+        # Calculate weight sum for in-bounds samples
+        weight_sum = torch.zeros_like(nw)
+        weight_sum = torch.where(
+            in_bounds_nw & valid_samples, weight_sum + nw, weight_sum
+        )
+        weight_sum = torch.where(
+            in_bounds_ne & valid_samples, weight_sum + ne, weight_sum
+        )
+        weight_sum = torch.where(
+            in_bounds_sw & valid_samples, weight_sum + sw, weight_sum
+        )
+        weight_sum = torch.where(
+            in_bounds_se & valid_samples, weight_sum + se, weight_sum
+        )
+
+        # Normalize weights where sum is positive
+        # Use a numerically stable approach with a minimum threshold
+        min_weight_sum = 1e-8
+        valid_sum = (weight_sum > min_weight_sum) & valid_samples
+
+        if valid_sum.any():
+            # Instead of directly dividing by weight_sum, use torch.where to be more explicit
+            # This helps PyTorch's autograd handle the operation more stably
+            safe_weight_sum = torch.clamp(weight_sum, min=min_weight_sum)
+
+            # Normalize weights only for valid samples with sufficient weight_sum
+            nw = torch.where(
+                valid_sum & in_bounds_nw,
+                nw / safe_weight_sum,
+                torch.where(in_bounds_nw, torch.zeros_like(nw), nw),
+            )
+            ne = torch.where(
+                valid_sum & in_bounds_ne,
+                ne / safe_weight_sum,
+                torch.where(in_bounds_ne, torch.zeros_like(ne), ne),
+            )
+            sw = torch.where(
+                valid_sum & in_bounds_sw,
+                sw / safe_weight_sum,
+                torch.where(in_bounds_sw, torch.zeros_like(sw), sw),
+            )
+            se = torch.where(
+                valid_sum & in_bounds_se,
+                se / safe_weight_sum,
+                torch.where(in_bounds_se, torch.zeros_like(se), se),
+            )
+
+    # Clamp coordinates to valid range for safe indexing
+    iy_nw_clamped = torch.clamp(iy_nw, 0, texture_size - 1)
+    ix_nw_clamped = torch.clamp(ix_nw, 0, texture_size - 1)
+    iy_ne_clamped = torch.clamp(iy_ne, 0, texture_size - 1)
+    ix_ne_clamped = torch.clamp(ix_ne, 0, texture_size - 1)
+    iy_sw_clamped = torch.clamp(iy_sw, 0, texture_size - 1)
+    ix_sw_clamped = torch.clamp(ix_sw, 0, texture_size - 1)
+    iy_se_clamped = torch.clamp(iy_se, 0, texture_size - 1)
+    ix_se_clamped = torch.clamp(ix_se, 0, texture_size - 1)
+
+    # Create batch indices for advanced indexing
+    batch_indices = torch.arange(M, device=device)
+
+    # Vectorized sampling with bounds checking
+    # NW corner
+    valid_nw = in_bounds_nw & valid_samples
+    if valid_nw.any():
+        nw_values = textures[
+            batch_indices[valid_nw], :, iy_nw_clamped[valid_nw], ix_nw_clamped[valid_nw]
+        ]  # [valid_count, channels]
+        result[valid_nw] += nw_values * nw[valid_nw].unsqueeze(1)  # Broadcasting weight
+
+    # NE corner
+    valid_ne = in_bounds_ne & valid_samples
+    if valid_ne.any():
+        ne_values = textures[
+            batch_indices[valid_ne], :, iy_ne_clamped[valid_ne], ix_ne_clamped[valid_ne]
+        ]
+        result[valid_ne] += ne_values * ne[valid_ne].unsqueeze(1)
+
+    # SW corner
+    valid_sw = in_bounds_sw & valid_samples
+    if valid_sw.any():
+        sw_values = textures[
+            batch_indices[valid_sw], :, iy_sw_clamped[valid_sw], ix_sw_clamped[valid_sw]
+        ]
+        result[valid_sw] += sw_values * sw[valid_sw].unsqueeze(1)
+
+    # SE corner
+    valid_se = in_bounds_se & valid_samples
+    if valid_se.any():
+        se_values = textures[
+            batch_indices[valid_se], :, iy_se_clamped[valid_se], ix_se_clamped[valid_se]
+        ]
+        result[valid_se] += se_values * se[valid_se].unsqueeze(1)
+
+    return result
+
