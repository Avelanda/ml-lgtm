+            result[c] +=
+                texture[c * texture_area + iy_nw * texture_size + ix_nw] * nw;
+        }
+        if (in_bounds_ne) {
+            result[c] +=
+                texture[c * texture_area + iy_ne * texture_size + ix_ne] * ne;
+        }
+        if (in_bounds_sw) {
+            result[c] +=
+                texture[c * texture_area + iy_sw * texture_size + ix_sw] * sw;
+        }
+        if (in_bounds_se) {
+            result[c] +=
+                texture[c * texture_area + iy_se * texture_size + ix_se] * se;
+        }
+    }
+}
+
+inline __device__ vec2 backward_bilinear_texture_sampler(
+    float *perchannel_grads,
+    float u,
+    float v,
+    const float *__restrict__ input,
+    float *__restrict__ grad_input,
+    int texture_size,
+    int channels,
+    bool texture_normalize,
+    bool texture_crop
+) {
+    float x = ((u + 1) / 2) * (texture_size - 1);
+    float y = ((v + 1) / 2) * (texture_size - 1);
+
+    int ix_nw = static_cast<int>(::floor(x));
+    int iy_nw = static_cast<int>(::floor(y));
+
+    int ix_ne = ix_nw + 1;
+    int iy_ne = iy_nw;
+    int ix_sw = ix_nw;
+    int iy_sw = iy_nw + 1;
+    int ix_se = ix_nw + 1;
+    int iy_se = iy_nw + 1;
+
+    // get surfaces to each neighbor:
+    float nw = (ix_se - x) * (iy_se - y);
+    float ne = (x - ix_sw) * (iy_sw - y);
+    float sw = (ix_ne - x) * (y - iy_ne);
+    float se = (x - ix_nw) * (y - iy_nw);
+
+    // Precompute in_bounds checks for each corner
+    bool in_bounds_nw = in_bounds_2d(iy_nw, ix_nw, texture_size, texture_size);
+    bool in_bounds_ne = in_bounds_2d(iy_ne, ix_ne, texture_size, texture_size);
+    bool in_bounds_sw = in_bounds_2d(iy_sw, ix_sw, texture_size, texture_size);
+    bool in_bounds_se = in_bounds_2d(iy_se, ix_se, texture_size, texture_size);
+    bool all_in_bounds =
+        in_bounds_nw && in_bounds_ne && in_bounds_sw && in_bounds_se;
+
+    // Shortcut for texture_crop
+    if (texture_crop && !all_in_bounds) {
+        vec2 grad_grid;
+        grad_grid.x = 0;
+        grad_grid.y = 0;
+        return grad_grid;
+    }
+
+    // For texture_normalize, we need to calculate weight normalization
+    float weight_sum = 0.0f;
+    if (texture_normalize) {
+        // Calculate the weight sum for in-bounds weights
+        if (in_bounds_nw) {
+            weight_sum += nw;
+        }
+        if (in_bounds_ne) {
+            weight_sum += ne;
+        }
+        if (in_bounds_sw) {
+            weight_sum += sw;
+        }
+        if (in_bounds_se) {
+            weight_sum += se;
+        }
+
+        if (weight_sum > 0.0f) {
+            // Normalize the weights for in-bounds pixels
+            if (in_bounds_nw) {
+                nw /= weight_sum;
+            } else {
+                nw = 0.0f;
+            }
+            if (in_bounds_ne) {
+                ne /= weight_sum;
+            } else {
+                ne = 0.0f;
+            }
+            if (in_bounds_sw) {
+                sw /= weight_sum;
+            } else {
+                sw = 0.0f;
+            }
+            if (in_bounds_se) {
+                se /= weight_sum;
+            } else {
+                se = 0.0f;
+            }
+        }
+    }
+
+    float gix = 0, giy = 0;
+    // calculate and set grad_input
+    int texture_area = texture_size * texture_size;
+    for (int c = 0; c < channels; ++c) {
+        int channel_offset = c * texture_area;
+        float g_out = perchannel_grads[c];
+
+        // Update grad_input using normalized weights
+        if (in_bounds_nw) {
+            atomicAdd(
+                grad_input + channel_offset + iy_nw * texture_size + ix_nw,
+                nw * g_out
+            );
+        }
+        if (in_bounds_ne) {
+            atomicAdd(
+                grad_input + channel_offset + iy_ne * texture_size + ix_ne,
+                ne * g_out
+            );
+        }
+        if (in_bounds_sw) {
+            atomicAdd(
+                grad_input + channel_offset + iy_sw * texture_size + ix_sw,
+                sw * g_out
+            );
+        }
+        if (in_bounds_se) {
+            atomicAdd(
+                grad_input + channel_offset + iy_se * texture_size + ix_se,
+                se * g_out
+            );
+        }
+
+        // For calculating gradients with respect to u and v
+        // When texture_normalize is true, we need to account for the
+        // normalization in the gradient calculation
+        if (texture_normalize && weight_sum > 0.0f) {
+            // Get the texture values at each corner
+            float nw_val = 0.0f;
+            float ne_val = 0.0f;
+            float sw_val = 0.0f;
+            float se_val = 0.0f;
+
+            if (in_bounds_nw) {
+                nw_val = input[channel_offset + iy_nw * texture_size + ix_nw];
+            }
+            if (in_bounds_ne) {
+                ne_val = input[channel_offset + iy_ne * texture_size + ix_ne];
+            }
+            if (in_bounds_sw) {
+                sw_val = input[channel_offset + iy_sw * texture_size + ix_sw];
+            }
+            if (in_bounds_se) {
+                se_val = input[channel_offset + iy_se * texture_size + ix_se];
+            }
+
+            // Calculate the normalized output value
+            float norm_output =
+                nw_val * nw + ne_val * ne + sw_val * sw + se_val * se;
+
+            // Calculate gradients with respect to normalized weights
+            // These derivatives account for the chain rule when weights are
+            // normalized
+            if (in_bounds_nw) {
+                float d_nw = (nw_val - norm_output) / weight_sum;
+                gix -= d_nw * (iy_se - y) * g_out;
+                giy -= d_nw * (ix_se - x) * g_out;
+            }
+
+            if (in_bounds_ne) {
+                float d_ne = (ne_val - norm_output) / weight_sum;
+                gix += d_ne * (iy_sw - y) * g_out;
+                giy -= d_ne * (x - ix_sw) * g_out;
+            }
+
+            if (in_bounds_sw) {
+                float d_sw = (sw_val - norm_output) / weight_sum;
+                gix -= d_sw * (y - iy_ne) * g_out;
+                giy += d_sw * (ix_ne - x) * g_out;
+            }
+
+            if (in_bounds_se) {
+                float d_se = (se_val - norm_output) / weight_sum;
+                gix += d_se * (y - iy_nw) * g_out;
+                giy += d_se * (x - ix_nw) * g_out;
+            }
+        } else {
+            // Regular gradient calculation without normalization
+            if (in_bounds_nw) {
+                float nw_val =
+                    input[channel_offset + iy_nw * texture_size + ix_nw];
+                gix -= nw_val * (iy_se - y) * g_out;
+                giy -= nw_val * (ix_se - x) * g_out;
+            }
+            if (in_bounds_ne) {
+                float ne_val =
+                    input[channel_offset + iy_ne * texture_size + ix_ne];
+                gix += ne_val * (iy_sw - y) * g_out;
+                giy -= ne_val * (x - ix_sw) * g_out;
+            }
+            if (in_bounds_sw) {
+                float sw_val =
+                    input[channel_offset + iy_sw * texture_size + ix_sw];
+                gix -= sw_val * (y - iy_ne) * g_out;
+                giy += sw_val * (ix_ne - x) * g_out;
+            }
+            if (in_bounds_se) {
+                float se_val =
+                    input[channel_offset + iy_se * texture_size + ix_se];
+                gix += se_val * (y - iy_nw) * g_out;
+                giy += se_val * (x - ix_nw) * g_out;
+            }
+        }
+    }
+    vec2 grad_grid;
+    grad_grid.x = gix * (texture_size - 1) / 2;
+    grad_grid.y = giy * (texture_size - 1) / 2;
+    return grad_grid;
+}
+
+} // namespace bbsplat
+} // namespace gsplat
