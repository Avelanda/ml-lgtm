+    float x = ((u + 1) / 2) * (texture_size - 1);
+    float y = ((v + 1) / 2) * (texture_size - 1);
+    int ix_nw = static_cast<int>(::floor(x));
+    int iy_nw = static_cast<int>(::floor(y));
+
+    int ix_ne = ix_nw + 1;
+    int iy_ne = iy_nw;
+    int ix_sw = ix_nw;
+    int iy_sw = iy_nw + 1;
+    int ix_se = ix_nw + 1;
+    int iy_se = iy_nw + 1;
