+#pragma once
+
+#include "Common.h"
+
+namespace gsplat {
+namespace bbsplat {
+
+// Bilinear texture sampler with border clamping (unbounded)
+//
+// When texture_sigma == 1.0f, it's strictly equivalent to:
+// - PyTorch's grid_sample with
+//   - mode="bilinear"
+//   - padding_mode="border"
+//   - align_corners=False
+// - OpenGL's
+//   - GL_LINEAR
+//   - GL_CLAMP_TO_EDGE
+//
+// The goal of the sampling is to map texture uv to actual texel value.
+// The larger the sigma, the larger the BBSplat span in the 2DGS primitive.
+inline __device__ void bilinear_texture_sampler_unbounded(
+    float *result,
+    float u,
+    float v,
+    const float *__restrict__ texture,
+    int texture_size,
+    int channels,
+    float texture_sigma = 1.0f
+) {
+    // sigma == 1.0f
+    // - u                             : [-1, 1]
+    // - (u + 1.0f) / 2.0f             : [0, 1]
+    // - (u + 1.0f) / 2.0f * ts        : [0, ts] (im_coords)
+    // - (u + 1.0f) / 2.0f * ts - 0.5f : [-0.5, ts - 0.5] (pix_coords)
+    // - clamped                       : [0, ts - 1]
+    //
+    // general sigma
+    // - u                              : [-s, s]
+    // - (u + s) / (2.0 * s)            : [0, 1]
+    // - (u + s) / (2.0 * s) * ts       : [0, ts] (im_coords)
+    // - (u + s) / (2.0 * s) * ts - 0.5f: [-0.5, ts - 0.5] (pix_coords)
+    // - clamped                        : [0, ts - 1]
+    float x =
+        (u + texture_sigma) / (2.0f * texture_sigma) * texture_size - 0.5f;
+    float y =
+        (v + texture_sigma) / (2.0f * texture_sigma) * texture_size - 0.5f;
+
+    // Apply border clamping (equivalent to padding_mode="border")
+    x = fmaxf(0.0f, fminf(texture_size - 1.0f, x));
+    y = fmaxf(0.0f, fminf(texture_size - 1.0f, y));
+
+    // Get integer coordinates for the 4 surrounding pixels
+    int ix_nw = static_cast<int>(::floor(x));
+    int iy_nw = static_cast<int>(::floor(y));
+    int ix_ne = min(ix_nw + 1, texture_size - 1);
+    int iy_ne = iy_nw;
+    int ix_sw = ix_nw;
+    int iy_sw = min(iy_nw + 1, texture_size - 1);
+    int ix_se = ix_ne;
+    int iy_se = iy_sw;
+
+    // Get fractional parts for interpolation
+    float f_x = x - ix_nw;
+    float f_y = y - iy_nw;
+
+    // Calculate bilinear weights
+    float nw = (1.0f - f_x) * (1.0f - f_y);
+    float ne = f_x * (1.0f - f_y);
+    float sw = (1.0f - f_x) * f_y;
+    float se = f_x * f_y;
+
+    // Calculate bilinear weighted pixel value and set output pixel
+    int texture_area = texture_size * texture_size;
+    for (int c = 0; c < channels; ++c) {
+        int channel_offset = c * texture_area;
+
+        result[c] = 0;
+        result[c] +=
+            nw * texture[channel_offset + iy_nw * texture_size + ix_nw];
+        result[c] +=
+            ne * texture[channel_offset + iy_ne * texture_size + ix_ne];
+        result[c] +=
+            sw * texture[channel_offset + iy_sw * texture_size + ix_sw];
+        result[c] +=
+            se * texture[channel_offset + iy_se * texture_size + ix_se];
+    }
+}
+
+inline __device__ vec2 backward_bilinear_texture_sampler_unbounded(
+    float *perchannel_grads,
+    float u,
+    float v,
+    const float *__restrict__ input,
+    float *__restrict__ grad_input,
+    int texture_size,
+    int channels,
+    float texture_sigma = 1.0f
+) {
+    // Convert from norm_im_coords [-sigma, sigma] to pix_coords
+    float x =
+        (u + texture_sigma) / (2.0f * texture_sigma) * texture_size - 0.5f;
+    float y =
+        (v + texture_sigma) / (2.0f * texture_sigma) * texture_size - 0.5f;
+
+    // Apply border clamping (equivalent to padding_mode="border")
+    float x_clamped = fmaxf(0.0f, fminf(texture_size - 1.0f, x));
+    float y_clamped = fmaxf(0.0f, fminf(texture_size - 1.0f, y));
+
+    // Get base corner coordinates (matches forward implementation)
+    int ix_nw = static_cast<int>(::floor(x));
+    int iy_nw = static_cast<int>(::floor(y));
+    int ix_ne = ix_nw + 1;
+    int iy_ne = iy_nw;
+    int ix_sw = ix_nw;
+    int iy_sw = iy_nw + 1;
+    int ix_se = ix_nw + 1;
+    int iy_se = iy_nw + 1;
+
+    // Get fractional parts for bilinear interpolation
+    float fx = x_clamped - ix_nw;
+    float fy = y_clamped - iy_nw;
+
+    // Clamp corner coordinates for texture access
+    int ix_nw_clamp = max(0, min(texture_size - 1, ix_nw));
+    int iy_nw_clamp = max(0, min(texture_size - 1, iy_nw));
+    int ix_ne_clamp = max(0, min(texture_size - 1, ix_ne));
+    int iy_ne_clamp = max(0, min(texture_size - 1, iy_ne));
+    int ix_sw_clamp = max(0, min(texture_size - 1, ix_sw));
+    int iy_sw_clamp = max(0, min(texture_size - 1, iy_sw));
+    int ix_se_clamp = max(0, min(texture_size - 1, ix_se));
+    int iy_se_clamp = max(0, min(texture_size - 1, iy_se));
+
+    // Calculate bilinear weights
+    float nw = (1.0f - fx) * (1.0f - fy);
+    float ne = fx * (1.0f - fy);
+    float sw = (1.0f - fx) * fy;
+    float se = fx * fy;
+
+    // Calculate and accumulate gradients to input texture (atomicAdd)
+    int texture_area = texture_size * texture_size;
+    for (int c = 0; c < channels; ++c) {
+        int channel_offset = c * texture_area;
+        float g_out = perchannel_grads[c];
+
+        atomicAdd(
+            grad_input + channel_offset + iy_nw_clamp * texture_size +
+                ix_nw_clamp,
+            nw * g_out
+        );
+        atomicAdd(
+            grad_input + channel_offset + iy_ne_clamp * texture_size +
+                ix_ne_clamp,
+            ne * g_out
+        );
+        atomicAdd(
+            grad_input + channel_offset + iy_sw_clamp * texture_size +
+                ix_sw_clamp,
+            sw * g_out
+        );
+        atomicAdd(
+            grad_input + channel_offset + iy_se_clamp * texture_size +
+                ix_se_clamp,
+            se * g_out
+        );
+    }
+
+    // Calculate gradients w.r.t. u and v coordinates
+    float gix = 0.0f;
+    float giy = 0.0f;
+
+    for (int c = 0; c < channels; ++c) {
+        int channel_offset = c * texture_area;
+        float g_out = perchannel_grads[c];
+
+        // Get texture values at each corner
+        float nw_val =
+            input[channel_offset + iy_nw_clamp * texture_size + ix_nw_clamp];
+        gix -= nw_val * (iy_se - y) * g_out;
+        giy -= nw_val * (ix_se - x) * g_out;
+
+        float ne_val =
+            input[channel_offset + iy_ne_clamp * texture_size + ix_ne_clamp];
+        gix += ne_val * (iy_sw - y) * g_out;
+        giy -= ne_val * (x - ix_sw) * g_out;
+
+        float sw_val =
+            input[channel_offset + iy_sw_clamp * texture_size + ix_sw_clamp];
+        gix -= sw_val * (y - iy_ne) * g_out;
+        giy += sw_val * (ix_ne - x) * g_out;
+
+        float se_val =
+            input[channel_offset + iy_se_clamp * texture_size + ix_se_clamp];
+        gix += se_val * (y - iy_nw) * g_out;
+        giy += se_val * (x - ix_nw) * g_out;
+    }
+
+    // Calculate gradient multipliers for coordinate transformation
+    // If coordinate is clamped, gradient w.r.t. normalized coord is zero
+    // Otherwise: d/du[(u + texture_sigma) / (2 * texture_sigma) * texture_size
+    // - 0.5] = texture_size / (2 * texture_sigma)
+    bool x_clamped_flag = (x < 0.0f) || (x > texture_size - 1.0f);
+    bool y_clamped_flag = (y < 0.0f) || (y > texture_size - 1.0f);
+
+    float gix_mult =
+        x_clamped_flag ? 0.0f : texture_size / (2.0f * texture_sigma);
+    float giy_mult =
+        y_clamped_flag ? 0.0f : texture_size / (2.0f * texture_sigma);
+
+    // Final coordinate gradients
+    vec2 grad_grid;
+    grad_grid.x = gix_mult * gix;
+    grad_grid.y = giy_mult * giy;
+    return grad_grid;
+}
+
+// Check if 2D coordinates are within texture bounds
+inline __device__ bool in_bounds_2d(int h, int w, int H, int W) {
+    return h >= 0 && h < H && w >= 0 && w < W;
+}
+
+// Default  : texture_normalize = false, texture_crop = false
+// Normlized: texture_normalize = true , texture_crop = false
+// Cropped  : texture_normalize = false, texture_crop = true
+inline __device__ void bilinear_texture_sampler(
+    float *result,
+    float u,
+    float v,
+    const float *__restrict__ texture,
+    int texture_size,
+    int channels,
+    bool texture_normalize,
+    bool texture_crop
