+def generate_test_data_random():
+    """Generate random test data for more comprehensive testing."""
+    torch.manual_seed(42)
+
+    # More gaussians with random positions
+    N = 8
+    means = torch.randn(N, 3, device=device)
+    means[:, 2] = torch.abs(means[:, 2]) + 1.0  # Ensure positive depth
+
+    # Random quaternions (normalized)
+    quats = torch.randn(N, 4, device=device)
+    quats = quats / torch.norm(quats, dim=-1, keepdim=True)
+
+    # Random scales
+    scales = torch.rand(N, 3, device=device) * 0.5 + 0.1  # Between 0.1 and 0.6
+
+    # Random opacities and colors
+    opacities = torch.rand(1, N, device=device)
+    colors = torch.rand(1, N, 3, device=device)
+
+    # Random viewmat (rotation + translation)
+    viewmat = torch.eye(4, device=device)
+    viewmat[:3, :3] = torch.eye(3) + 0.1 * torch.randn(
+        3, 3
+    )  # Small rotation perturbation
+    viewmat[:3, 3] = torch.randn(3) * 0.5  # Random translation
+    viewmats = viewmat.reshape(1, 4, 4)
+
+    # Random camera intrinsics
+    W, H = 80, 60
+    fx = W + torch.randn(1).item() * 10
+    fy = W + torch.randn(1).item() * 10
+    cx = W // 2 + torch.randn(1).item() * 5
+    cy = H // 2 + torch.randn(1).item() * 5
+    Ks = torch.tensor(
+        [[fx, 0.0, cx], [0.0, fy, cy], [0.0, 0.0, 1.0]], device=device
+    ).reshape(1, 3, 3)
+
+    return {
+        "means": means,
+        "quats": quats,
+        "scales": scales,
+        "opacities": opacities,
+        "colors": colors,
+        "viewmats": viewmats,
+        "Ks": Ks,
+        "width": W,
+        "height": H,
+    }
+
